indent_size = unset


# This exact workflow contains a canonical folded-expression scalar payload.
# Mandatory native Prettier checks YAML structure; preserve its literal spacing.
[/.github/workflows/publish-workspace-lock.yml]
indent_size = unset

# These two status documents contain canonical two-space list continuations.
# Required native Prettier validates their complete Markdown structure.
[/design-docs/{error-handling-implementation-plan.status.md,module-call-event-naming-implementation-plan.status.md}]
indent_size = 2
